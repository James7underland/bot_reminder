# Шаблон окружения. Скопируйте в .env и заполните реальными значениями.
# .env НЕ коммитится (см. .gitignore). Секреты в коде/гите запрещены.

# Токен бота из @BotFather (используйте НОВЫЙ токен после revoke)
TELEGRAM_BOT_TOKEN=

# Путь к локальной SQLite-базе (MVP, Фазы 2-5)
DATABASE_PATH=./data/tasks.db

# Фаза 6: PostgreSQL. Если задан DATABASE_URL — используется он, не SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/bot_reminder

# Phase 11.1: URL Mini App, на который ведёт WebApp-кнопка /start.
# Phase 11.26: домен переехал на поддомен app.reminderr.ru
# (reminderr.ru теперь — отдельный сайт, не связанный с ботом).
# MINI_APP_URL=https://app.reminderr.ru/

# Phase 11.3: ограничение доступа. Если оба пустые — доступ всем
# (старое поведение). Запятая = разделитель. ID стабильнее username'ов.
# ALLOWED_USER_IDS=123456789
# ALLOWED_USERNAMES=e_rnst

# Phase 10.3: каталог для файловых логов с ротацией. Без него — только stdout.
# LOG_DIR=/var/log/bot_reminder
