# Шаблон окружения. Скопируйте в .env и заполните реальными значениями.
# .env НЕ коммитится (см. .gitignore). Секреты в коде/гите запрещены.

# Токен бота из @BotFather (используйте НОВЫЙ токен после revoke)
TELEGRAM_BOT_TOKEN=

# Путь к локальной SQLite-базе (MVP, Фазы 2-5)
DATABASE_PATH=./data/tasks.db

# Фаза 6: PostgreSQL. Если задан DATABASE_URL — используется он, не SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/bot_reminder
